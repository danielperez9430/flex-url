{
    "name": "open-southeners/flex-url",
    "description": "Zero-dependency URL builder/parser for the apiable request grammar (PHP mirror)",
    "license": "MIT",
    "keywords": [
        "open-southeners",
        "flex-url",
        "url",
        "query-string",
        "json-api",
        "apiable"
    ],
    "authors": [
        {
            "name": "Ruben Robles",
            "email": "me@d8vjork.com"
        }
    ],
    "homepage": "https://github.com/open-southeners/flex-url#readme",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OpenSoutheners\\FlexUrl\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSoutheners\\FlexUrl\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-v2": "2.x-dev"
        }
    },
    "scripts": {
        "lint": [
            "pint",
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    }
}
