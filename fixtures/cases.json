  {
    "name": "between sugars into a gte+lte range filter",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "between",
        "args": [
          "due_at",
          "2024-01-01",
          "2024-01-31"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[due_at][gte]=2024-01-01&filter[due_at][lte]=2024-01-31",
    "reads": [
      {
        "op": "getFilter",
        "args": [
          "due_at",
          "gte"
        ],
        "equals": "2024-01-01"
      },
      {
        "op": "getFilter",
        "args": [
          "due_at",
          "lte"
        ],
        "equals": "2024-01-31"
      },
      {
        "op": "hasFilter",
        "args": [
          "due_at",
          "gte"
        ],
        "equals": true
      }
    ]
  },
  {
    "name": "multi-operator range built from two filter() calls",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "due_at",
          "gte",
          "2024-01-01"
        ]
      },
      {
        "op": "filter",
        "args": [
          "due_at",
          "lte",
          "2024-01-31"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[due_at][gte]=2024-01-01&filter[due_at][lte]=2024-01-31",
    "reads": [
      {
        "op": "getFilter",
        "args": [
          "due_at",
          "gte"
        ],
        "equals": "2024-01-01"
      },
      {
        "op": "getFilter",
        "args": [
          "due_at",
          "lte"
        ],
        "equals": "2024-01-31"
      },
      {
        "op": "toParams",
        "args": [],
        "equals": {
          "filter": {
            "due_at": {
              "gte": "2024-01-01",
              "lte": "2024-01-31"
            }
          }
        }
      }
    ]
  },
